{
    "app-id" : "io.github.fedoranova.FedoraNova.Devel",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "fedora-nova-settings-devel",
    "finish-args" : [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--env=FEDORA_NOVA_PREVIEW=1",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "modules" : [
        {
            "name" : "fedora-nova",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : ".",
                    "skip" : [
                        ".git",
                        ".flatpak-builder",
                        ".flatpak-build-test",
                        ".dev-build",
                        "_build",
                        "build",
                        "__pycache__",
                        "*.pyc",
                        "*.pyo",
                        ".cache",
                        ".idea",
                        ".vscode"
                    ]
                }
            ],
            "config-opts" : [
                "--libdir=lib"
            ]
        }
    ],
    "build-options" : {
        "env" : {        }
    }
}
