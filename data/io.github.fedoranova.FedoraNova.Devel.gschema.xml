<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.fedoranova.FedoraNova.Devel"
          path="/io/github/fedoranova/FedoraNova/Devel/">
    <key name="window-width" type="i">
      <default>1040</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="last-page" type="s">
      <default>'appearance'</default>
      <summary>Last selected settings page</summary>
    </key>
  </schema>
</schemalist>
